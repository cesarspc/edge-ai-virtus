# ---------------------------------------------------------------
# Datos: viven solo en local (tamaño y licencias). Ver data/raw/README.md
# ---------------------------------------------------------------
data/raw/*
!data/raw/README.md
data/interim/
data/processed/

# Imágenes (no versionar fotografías de los datasets)
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.tif
*.tiff
*.webp
# ...salvo las figuras pequeñas generadas para los informes
!reports/figures/*.png
!reports/s5/**/*.png
!reports/s6/**/*.png
!reports/crops_v002/**/figures/*.png
reports/crops_v002/**/chunks/
reports/crops_v002/**/probabilities_val.npz
reports/crops_v002/**/campaign.lock
# Bootstrap progress checkpoints can be rebuilt from the report inputs.
reports/**/bootstrap_state.npz

# Archivos comprimidos / pesados
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar
*.part

# Modelos y checkpoints (fases posteriores)
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.h5
*.safetensors
checkpoints/
models/
# salidas de entrenamiento (scripts/train/train_ma.py)
runs/
artifacts/baselines/

# Cachés y temporales
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.cache/
.pytest_cache/
.mypy_cache/
*.tmp
tmp/

# Entornos virtuales
.venv/
venv/
env/

# Sistema operativo / editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

